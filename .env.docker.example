# Development same-domain setup
# Copy to .env: cp .env.docker.example .env

GATEWAY_PORT=8000
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000
ADMIN_URL=http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_cms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

AUTO_MIGRATE=true
AUTO_SEED=true

GOOGLE_CLIENT_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=/var/www/html/storage/app/google-service-account.json

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0

PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123456
